{
  "name": "mayi",
  "version": "0.1.0",
  "private": true,
  "description": "MayI FinePrint — a Chrome extension that answers “May I…?” from a site’s real terms, with the clause cited.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 44731 --strictPort",
    "lab": "node scripts/lab.mjs",
    "setup": "npm install",
    "build": "node scripts/make-icons.mjs && node scripts/build-extension.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/source-sans-3": "^5.2.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.3.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/chrome": "^0.1.31",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
