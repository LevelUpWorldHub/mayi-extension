# Copy to .env.local for the lab (vite dev) and rebuild the extension after
# filling these in. Never commit real keys or a debug token.

# Firebase web app config (Project settings → Your apps → Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA Enterprise score-based site key, registered in
# Firebase App Check as the attestation provider for this app.
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=

# Local development only. Set to true to print a debug token in the
# console, or paste a token you already registered under
# App Check → Apps → Manage debug tokens.
# Do not set this in a build you ship.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Production extension path. HTTPS page deployed to Firebase Hosting
# (see hosting/public/app-check.html) that runs reCAPTCHA Enterprise
# inside an offscreen iframe. Manifest V3 cannot load that script in
# the side panel. Example: https://YOUR_PROJECT.web.app/app-check.html
VITE_APPCHECK_BRIDGE_URL=

# 32-character Chrome extension id. The bridge only postMessages tokens
# to chrome-extension://THIS_ID.
VITE_EXTENSION_ID=
